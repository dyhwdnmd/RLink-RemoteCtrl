<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="Current" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <Import Project="LocalBuild.props" Condition="Exists('LocalBuild.props')" />
  <PropertyGroup>
    <WebRtcSourceDir Condition="'$(WebRtcSourceDir)'==''">E:\webrtc_src\src</WebRtcSourceDir>
    <WebRtcOutputDir Condition="'$(WebRtcOutputDir)'==''">$(WebRtcSourceDir)\out\ReleaseMD</WebRtcOutputDir>
    <FfmpegD3D11VaDir Condition="'$(FfmpegD3D11VaDir)'==''">$(MSBuildThisFileDirectory)..\third_party\ffmpeg_d3d11va\prefix</FfmpegD3D11VaDir>
    <OutDir>$(MSBuildThisFileDirectory)..\x64\$(Configuration)\</OutDir>
    <IntDir>$(MSBuildThisFileDirectory)..\x64\$(Configuration)\$(ProjectName)\</IntDir>
  </PropertyGroup>
  <ItemDefinitionGroup>
    <ClCompile>
      <AdditionalIncludeDirectories>$(MSBuildThisFileDirectory)..\;$(FfmpegD3D11VaDir)\include;$(WebRtcSourceDir)\third_party\abseil-cpp;$(WebRtcOutputDir)\gen;$(WebRtcSourceDir);%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
      <PreprocessorDefinitions>NDEBUG;WEBRTC_WIN;RTC_ENABLE_WIN_WGC;NOMINMAX;WIN32_LEAN_AND_MEAN;%(PreprocessorDefinitions)</PreprocessorDefinitions>
      <LanguageStandard>stdcpp20</LanguageStandard>
      <RuntimeLibrary>MultiThreadedDLL</RuntimeLibrary>
      <MultiProcessorCompilation>true</MultiProcessorCompilation>
      <WarningLevel>Level3</WarningLevel>
      <SDLCheck>true</SDLCheck>
      <ConformanceMode>true</ConformanceMode>
      <FunctionLevelLinking>true</FunctionLevelLinking>
      <IntrinsicFunctions>true</IntrinsicFunctions>
      <DebugInformationFormat>ProgramDatabase</DebugInformationFormat>
      <DisableSpecificWarnings>4068;4146;4996;%(DisableSpecificWarnings)</DisableSpecificWarnings>
      <AdditionalOptions>/utf-8 /Zc:__cplusplus /Zo %(AdditionalOptions)</AdditionalOptions>
    </ClCompile>
    <Link>
      <SubSystem>Console</SubSystem>
      <AdditionalLibraryDirectories>$(WebRtcOutputDir)\obj;%(AdditionalLibraryDirectories)</AdditionalLibraryDirectories>
      <AdditionalDependencies>webrtc.lib;$(WebRtcOutputDir)\obj\api\video\adapted_video_track_source.lib;$(WebRtcOutputDir)\obj\api\video_codecs\builtin_video_decoder_factory.lib;$(WebRtcOutputDir)\obj\api\video_codecs\builtin_video_encoder_factory.lib;$(WebRtcOutputDir)\obj\api\video_codecs\rtc_software_fallback_wrappers.lib;$(WebRtcOutputDir)\obj\media\rtc_internal_video_codecs.lib;$(WebRtcOutputDir)\obj\media\rtc_simulcast_encoder_adapter.lib;d3d11.lib;d3d10.lib;dxgi.lib;dwmapi.lib;shcore.lib;mf.lib;mfplat.lib;mfuuid.lib;ole32.lib;ws2_32.lib;winmm.lib;secur32.lib;crypt32.lib;bcrypt.lib;iphlpapi.lib;dmoguids.lib;msdmo.lib;wmcodecdspuuid.lib;strmiids.lib;%(AdditionalDependencies)</AdditionalDependencies>
      <GenerateDebugInformation>true</GenerateDebugInformation>
      <EnableCOMDATFolding>true</EnableCOMDATFolding>
      <OptimizeReferences>true</OptimizeReferences>
    </Link>
  </ItemDefinitionGroup>
</Project>
